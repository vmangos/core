####################################################################################################
# TELEPORTS
####################################################################################################

# Map IDs where bots may be teleported. Vanilla defaults are Eastern Kingdoms and Kalimdor.
AiPlayerbot.RandomBotMaps = 0,1

# Chance bots teleport to a banker or capital city.
AiPlayerbot.ProbTeleToBankers = 0.25

# Capital city banker weighting.
AiPlayerbot.EnableWeightTeleToCityBankers = 1
AiPlayerbot.TeleToStormwindWeight = 2
AiPlayerbot.TeleToIronforgeWeight = 1
AiPlayerbot.TeleToDarnassusWeight = 1
AiPlayerbot.TeleToExodarWeight = 0
