AiPlayerbot.RandomBotTeleLowerLevel = 1
AiPlayerbot.RandomBotTeleHigherLevel = 3

# Teleport bots to new leveling areas when they level up.
AiPlayerbot.AutoTeleportForLevel = 1

####################################################################################################
# BATTLEGROUNDS & PVP
####################################################################################################

# Allow randombots to join battlegrounds.
AiPlayerbot.RandomBotJoinBG = 1

# Allow bots to auto-start supported battleground queues.
AiPlayerbot.RandomBotAutoJoinBG = 0

# Auto-join battleground bracket selections for Vanilla battlegrounds only.
AiPlayerbot.RandomBotAutoJoinAVBrackets = 3
AiPlayerbot.RandomBotAutoJoinABBrackets = 5
AiPlayerbot.RandomBotAutoJoinWSBrackets = 5

