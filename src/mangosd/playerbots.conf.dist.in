# Speed up battleground reactions.
AiPlayerbot.FastReactInBG = 1

####################################################################################################
# RANDOM BOT TIMING AND BEHAVIOR
####################################################################################################

# Manager update cadence, in seconds.
AiPlayerbot.RandomBotUpdateInterval = 20

# How often the manager adjusts the online random bot count.
AiPlayerbot.RandomBotCountChangeMinInterval = 1800
AiPlayerbot.RandomBotCountChangeMaxInterval = 7200

# Minimum and maximum number of seconds a random bot remains online before cycling out.
AiPlayerbot.MinRandomBotInWorldTime = 3600
AiPlayerbot.MaxRandomBotInWorldTime = 1209600

# Re-randomization timing.
AiPlayerbot.MinRandomBotRandomizeTime = 7200
AiPlayerbot.MaxRandomBotRandomizeTime = 1209600

# Number of bots processed per manager update.
AiPlayerbot.RandomBotsPerInterval = 60

# Revive timing after death.
AiPlayerbot.MinRandomBotReviveTime = 60
AiPlayerbot.MaxRandomBotReviveTime = 300

# Teleport timing between leveling areas.
AiPlayerbot.MinRandomBotTeleportInterval = 3600
AiPlayerbot.MaxRandomBotTeleportInterval = 18000

# Lifetime for bots marked as permanently in world or used when rotation is effectively disabled.
AiPlayerbot.PermanentlyInWorldTime = 31104000

####################################################################################################
# PREMADE SPECS AND TALENT DATA
#
# The integrated runtime still has premade-spec related config families, but the original WotLK
# payloads are intentionally not shipped in this Vanilla template.
#
# Reasons:
# - WotLK glyph data is invalid in Vanilla.
# - WotLK talent strings are not suitable for Vanilla trees.
# - Death Knight content is not applicable to vMaNGOS Vanilla.
#
# A future Vanilla-specific premade dataset can be introduced separately.
####################################################################################################

####################################################################################################
# SYSTEM, DEBUG, CHAT, AND LOGGING
#
# This section is the top-level home for infrastructure settings that do not fit gameplay buckets.
####################################################################################################

####################################################################################################
# DEBUG
####################################################################################################

# Command server port. Set to 0 to disable.
AiPlayerbot.CommandServerPort = 8888

# Restrict some manager operations to bots in groups only.
AiPlayerbot.LogInGroupOnly = 1

# Enable extra per-tick value logging.
AiPlayerbot.LogValuesPerTick = 0

# Debug multiplier used by some random-change systems.
AiPlayerbot.RandomChangeMultiplier = 1

# Tell players which spell triggered avoid-aoe behavior.
AiPlayerbot.TellWhenAvoidAoe = 0

# Enable the performance monitor.
AiPlayerbot.PerfMonEnabled = 0

####################################################################################################
# CHAT SETTINGS
####################################################################################################

# Prefix and separator used for bot chat commands.
AiPlayerbot.CommandPrefix = ""
AiPlayerbot.CommandSeparator = "\\"

# Basic bot social behavior.
AiPlayerbot.RandomBotTalk = 0
AiPlayerbot.RandomBotEmote = 0
