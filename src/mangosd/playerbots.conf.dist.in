########################################
# ModPlayerBots Configuration file     #
########################################

[PlayerbotsConf]
ConfVersion=2026030605

####################################################################################################
# OVERVIEW
#
# This file is loaded by `mangosd` after `mangosd.conf` and overlays matching keys.
# Rename it to `playerbots.conf` and keep it in the same directory as `mangosd.conf`.
#
# The integrated playerbots module is Vanilla-first. This template intentionally excludes or rewrites
# settings whose original WotLK documentation would be misleading on a Vanilla core.
#
# Unspecified `AiPlayerbot.*` settings fall back to the defaults compiled into
# `core/src/game/ModPlayerBots/PlayerbotAIConfig.cpp`.
####################################################################################################

####################################################################################################
# DATABASE & CONNECTIONS
#
# `PlayerbotsDatabase.*` configures the separate playerbots database used by the integrated module.
#
# `PlayerbotsDatabase.Info`
#   Database connection string in the format:
#   "hostname;port;username;password;database"
#
# `PlayerbotsDatabase.Connections`
#   Number of synchronous SELECT connections.
#
# `PlayerbotsDatabase.WorkerThreads`
#   Number of asynchronous worker connections.
####################################################################################################
PlayerbotsDatabase.Info          = "127.0.0.1;3306;mangos;mangos;playerbots"
PlayerbotsDatabase.Connections   = 2
PlayerbotsDatabase.WorkerThreads = 1

####################################################################################################
# CORE SETTINGS
#
# High-level module switches and common random bot defaults.
####################################################################################################
AiPlayerbot.Enabled = 1
AiPlayerbot.RandomBotAutologin = 1

# Target online randombot population.
AiPlayerbot.MinRandomBots = 500
AiPlayerbot.MaxRandomBots = 500

# Number of accounts reserved for randombots.
# 0 = determine automatically
AiPlayerbot.RandomBotAccountCount = 0

# Delete all randombot accounts on startup when set to 1.
AiPlayerbot.DeleteRandomBotAccounts = 0

# Keep randombots offline until a real player is online.
AiPlayerbot.DisabledWithoutRealPlayer = 0
AiPlayerbot.DisabledWithoutRealPlayerLoginDelay = 30
AiPlayerbot.DisabledWithoutRealPlayerLogoutDelay = 300

AiPlayerbot.EnableNewRpgStrategy = 1
AiPlayerbot.AutoDoQuests = 1

####################################################################################################
# PLAYERBOTS SETTINGS
#
# This section is the top-level home for settings that affect player-controlled bots, summons,
# combat behavior, AI pacing, and other core bot interactions.
####################################################################################################

####################################################################################################
# GENERAL
####################################################################################################

# Maximum number of bots a player can control at once.
AiPlayerbot.MaxAddedBots = 40

# Allow the `addclass` command.
# 0 = GM only
# 1 = enabled
AiPlayerbot.AddClassCommand = 1

# Number of pooled accounts used by the `addclass` command.
AiPlayerbot.AddClassAccountPoolSize = 50

# Invitation policy for player-controlled bots.
# 0 = GM only
# 1 = accept based on level
# 2 = always accept
AiPlayerbot.GroupInvitationPermission = 1

# Keep alt bots in the party after the master leaves.
AiPlayerbot.KeepAltsInGroup = 0

# Auto-login player alts as altbots on player login.
AiPlayerbot.BotAutologin = 0

# Allow inviting altbots from the same account.
AiPlayerbot.AllowAccountBots = 1

# Allow inviting altbots from the player's guild.
AiPlayerbot.AllowGuildBots = 1

# Allow linked accounts for shared altbot control.
AiPlayerbot.AllowTrustedAccountBots = 1

# Allow randombots to form guilds with nearby randombots.
AiPlayerbot.RandomBotGuildNearby = 0

# Number of guilds created by randombots.
AiPlayerbot.RandomBotGuildCount = 20

# Maximum number of members in randombot guilds.
AiPlayerbot.RandomBotGuildSizeMax = 15

# Delete all randombot guilds on startup when set to 1.
AiPlayerbot.DeleteRandomBotGuilds = 0

# Allow randombots to invite players to groups, raids, or guilds.
AiPlayerbot.RandomBotInvitePlayer = 0

# Allow bots to chat when inviting other bots or players.
AiPlayerbot.InviteChat = 0

# Summon bots automatically when they accept a group invitation.
AiPlayerbot.SummonWhenGroup = 1

# Allow a player to be activated as a selfbot.
# 0 = disabled
# 1 = GM only
# 2 = all players
# 3 = activate on login
AiPlayerbot.SelfBotLevel = 1

# Restrict non-GM initialization to `init=auto` only.
AiPlayerbot.AutoInitOnly = 0

# Upper equipment-level ratio used by `init=auto`.
AiPlayerbot.AutoInitEquipLevelLimitRatio = 1.0

# Trainer spell behavior.
# yes = train normally
# free = train without cost
# no = list only
AiPlayerbot.AutoTrainSpells = yes

####################################################################################################
# SUMMON OPTIONS
####################################################################################################

# Allow summoning bots while the master is in combat.
AiPlayerbot.AllowSummonInCombat = 1

# Allow summoning bots while the master is dead.
AiPlayerbot.AllowSummonWhenMasterIsDead = 1

# Allow summoning dead bots.
# 0 = ghosts only
# 1 = always
AiPlayerbot.AllowSummonWhenBotIsDead = 1

# Revive behavior when summoning bots.
# 0 = disabled
# 1 = disabled during combat
# 2 = enabled
AiPlayerbot.ReviveBotWhenSummoned = 1

# Repair bot gear on summon.
AiPlayerbot.BotRepairWhenSummon = 1

####################################################################################################
# MOUNT
####################################################################################################

# Ground mount thresholds. These values are loaded by the integrated runtime as generic progression
# controls. On Vanilla, only ground mount progression is normally relevant.
AiPlayerbot.UseGroundMountAtMinLevel = 20
AiPlayerbot.UseFastGroundMountAtMinLevel = 40

# Flying mount thresholds are retained only because the runtime still exposes them. They are not
# part of normal Vanilla gameplay and can usually be left at their defaults.
AiPlayerbot.UseFlyMountAtMinLevel = 60
AiPlayerbot.UseFastFlyMountAtMinLevel = 70

####################################################################################################
# GEAR
####################################################################################################

# Cosmetic toggles for randombot display.
AiPlayerbot.RandomBotShowHelmet = 1
AiPlayerbot.RandomBotShowCloak = 1

# Let altbots auto-equip clear inventory upgrades.
AiPlayerbot.AutoEquipUpgradeLoot = 1

# Upgrade threshold for auto-equip logic.
AiPlayerbot.EquipUpgradeThreshold = 1.1

# Run two rounds of gear initialization for better initial results.
AiPlayerbot.TwoRoundsGearInit = 0

####################################################################################################
# LOOTING
####################################################################################################

# Keep bots looting when the group loot method is free-for-all.
AiPlayerbot.FreeMethodLoot = 0

# Default loot roll behavior.
# 0 = pass
# 1 = greed
# 2 = need
AiPlayerbot.LootRollLevel = 1

####################################################################################################
# TIMERS
####################################################################################################

# Maximum AI iterations per server tick.
AiPlayerbot.IterationsPerTick = 10

# Delay between short-cooldown spell casts, in milliseconds.
AiPlayerbot.GlobalCooldown = 500

# Maximum wait time while moving, in milliseconds.
AiPlayerbot.MaxWaitForMove = 5000

# Control MoveSplinePath usage.
# 0 = enabled everywhere
# 1 = disabled in BG only
# 2 = disabled everywhere
AiPlayerbot.DisableMoveSplinePath = 0

# Path search budget for movement.
AiPlayerbot.MaxMovementSearchTime = 3

# Action expiration time in milliseconds.
AiPlayerbot.ExpireActionTime = 5000

# Maximum duration considered for dispellable auras.
AiPlayerbot.DispelAuraDuration = 700

# Base delay between bot reactions, in milliseconds.
AiPlayerbot.ReactDelay = 100

# Dynamically adjust react delay to reduce server load.
AiPlayerbot.DynamicReactDelay = 1

# Delay before inactive behavior kicks in, in milliseconds.
AiPlayerbot.PassiveDelay = 10000

# Minimum delay before repeating actions such as chat or emotes.
AiPlayerbot.RepeatDelay = 2000

# Miscellaneous delay timers, in milliseconds.
AiPlayerbot.ErrorDelay = 100
AiPlayerbot.RpgDelay = 10000
AiPlayerbot.SitDelay = 20000
AiPlayerbot.ReturnDelay = 2000
AiPlayerbot.LootDelay = 1000

####################################################################################################
# DISTANCES
####################################################################################################

# Distances are measured in yards.
AiPlayerbot.FarDistance = 20.0
AiPlayerbot.SightDistance = 75.0
AiPlayerbot.SpellDistance = 28.5
AiPlayerbot.ShootDistance = 26.0
AiPlayerbot.HealDistance = 38.5
AiPlayerbot.LootDistance = 25.0
AiPlayerbot.FleeDistance = 8.0
AiPlayerbot.AggroDistance = 22
AiPlayerbot.TooCloseDistance = 5.0
AiPlayerbot.MeleeDistance = 1.5
AiPlayerbot.FollowDistance = 1.5
AiPlayerbot.WhisperDistance = 6000.0
AiPlayerbot.ContactDistance = 0.5
AiPlayerbot.AoeRadius = 10
AiPlayerbot.RpgDistance = 200
AiPlayerbot.GrindDistance = 75.0
AiPlayerbot.ReactDistance = 150.0

####################################################################################################
# THRESHOLDS
####################################################################################################

# Health and mana thresholds, in percent.
AiPlayerbot.CriticalHealth = 25
AiPlayerbot.LowHealth = 45
AiPlayerbot.MediumHealth = 65
AiPlayerbot.AlmostFullHealth = 85
AiPlayerbot.LowMana = 15
AiPlayerbot.MediumMana = 40
AiPlayerbot.HighMana = 65

####################################################################################################
# QUESTS
####################################################################################################

# Quest reward handling.
# yes = pick the most useful reward
# no = list rewards only
# ask = pick a useful reward and report alternatives
AiPlayerbot.AutoPickReward = yes

# Sync bot quest completion with the player.
AiPlayerbot.SyncQuestWithPlayer = 1

# Allow bots to auto-complete quests for the player when turning in their own quests.
AiPlayerbot.SyncQuestForPlayer = 0

# Drop obsolete quests automatically.
AiPlayerbot.DropObsoleteQuests = 1

####################################################################################################
# COMBAT
####################################################################################################

# Add dungeon or raid strategies automatically when entering supported instances.
AiPlayerbot.ApplyInstanceStrategies = 1

# Enable the generic avoid-aoe strategy.
AiPlayerbot.AutoAvoidAoe = 1

# Only avoid area effects up to this radius.
AiPlayerbot.MaxAoeAvoidRadius = 15.0

# Spell IDs that should never trigger generic AOE avoidance.
AiPlayerbot.AoeAvoidSpellWhitelist = 50759,57491,13810,29946

# Enable healer mana-saving behavior.
AiPlayerbot.AutoSaveMana = 1

# Mana percentage below which the save-mana strategy becomes active.
AiPlayerbot.SaveManaThreshold = 60

# Allow bots to flee from enemies when appropriate.
AiPlayerbot.FleeingEnabled = 1

####################################################################################################
# GREATER BUFFS STRATEGIES
####################################################################################################

# Minimum group size before bots prefer greater group buffs.
AiPlayerbot.MinBotsForGreaterBuff = 3

# Cooldown between reagent-missing RP warnings, in seconds.
AiPlayerbot.RPWarningCooldown = 30

####################################################################################################
# CHEATS
####################################################################################################

# Enable the maintenance command.
AiPlayerbot.MaintenanceCommand = 1

# Altbot maintenance toggles.
AiPlayerbot.AltMaintenanceAmmo = 1
AiPlayerbot.AltMaintenanceFood = 1
AiPlayerbot.AltMaintenanceReagents = 1
AiPlayerbot.AltMaintenanceConsumables = 1
AiPlayerbot.AltMaintenancePotions = 1
AiPlayerbot.AltMaintenanceBags = 1
AiPlayerbot.AltMaintenanceMounts = 1
AiPlayerbot.AltMaintenanceSkills = 1
AiPlayerbot.AltMaintenanceClassSpells = 1
AiPlayerbot.AltMaintenanceAvailableSpells = 1
AiPlayerbot.AltMaintenanceSpecialSpells = 1
AiPlayerbot.AltMaintenanceTalentTree = 1

# Glyph and gem/enchant maintenance settings are still read by the integrated runtime but are kept
# here as legacy compatibility knobs. They are not generally relevant on a Vanilla server.
AiPlayerbot.AltMaintenanceGlyphs = 1
AiPlayerbot.AltMaintenanceGemsEnchants = 1

AiPlayerbot.AltMaintenancePet = 1
AiPlayerbot.AltMaintenancePetTalents = 1
AiPlayerbot.AltMaintenanceReputation = 1
AiPlayerbot.AltMaintenanceAttunementQuests = 1
AiPlayerbot.AltMaintenanceKeyring = 1

# Enable automatic gear upgrades through the autogear command.
AiPlayerbot.AutoGearCommand = 1
AiPlayerbot.AutoGearCommandAltBots = 1

# Generic quality and item-level caps for autogear.
AiPlayerbot.AutoGearQualityLimit = 4
AiPlayerbot.AutoGearScoreLimit = 0

# Bot cheat list. Multiple values may be combined with commas.
# Common values: food, taxi, gold, health, mana, power, raid
AiPlayerbot.BotCheats = "food,taxi,raid"

####################################################################################################
# FLIGHTPATH
####################################################################################################

# Taxi staggering controls in milliseconds.
AiPlayerbot.BotTaxiDelayMinMs = 350
AiPlayerbot.BotTaxiDelayMaxMs = 5000
AiPlayerbot.BotTaxiGapMs = 200
AiPlayerbot.BotTaxiGapJitterMs = 100

####################################################################################################
# PROFESSIONS
####################################################################################################

# Fishing support settings.
AiPlayerbot.EnableFishingWithMaster = 1
AiPlayerbot.FishingDistanceFromMaster = 10.0
AiPlayerbot.FishingDistance = 40.0
AiPlayerbot.EndFishingWithMaster = 30.0

####################################################################################################
# RANDOMBOT SETTINGS
#
# This section is the top-level home for autonomous random bot behavior.
####################################################################################################

####################################################################################################
# GENERAL
####################################################################################################

# Generate random passwords for randombot accounts.
AiPlayerbot.RandomBotRandomPassword = 0

# Prefix used for new randombot account names.
AiPlayerbot.RandomBotAccountPrefix = "rndbot"

# Minimum and maximum levels for generated randombots.
AiPlayerbot.RandomBotMinLevel = 1
AiPlayerbot.RandomBotMaxLevel = 80

# Sync the maximum random bot level with the highest online player level.
AiPlayerbot.SyncLevelWithPlayers = 0

# Pre-complete many lower-level quests during bot creation.
AiPlayerbot.PreQuests = 0

# Allow randombots to join the queue systems supported by the integrated runtime.
AiPlayerbot.RandomBotJoinLfg = 1

# Rotate bots online and offline from a larger total pool.
AiPlayerbot.EnablePeriodicOnlineOffline = 0
AiPlayerbot.PeriodicOnlineOfflineRatio = 2.0

# Faction ratio for generated randombots.
AiPlayerbot.RandomBotAllianceRatio = 50
AiPlayerbot.RandomBotHordeRatio = 50

# Legacy non-Vanilla compatibility switch retained by the runtime.
AiPlayerbot.DisableDeathKnightLogin = 0

# Legacy expansion talent limiter retained by the runtime.
AiPlayerbot.LimitTalentsExpansion = 0

# Trading mode for randombots.
# 0 = disabled
# 1 = enabled
# 2 = buy only
# 3 = sell only
AiPlayerbot.EnableRandomBotTrading = 1

# Prefixes ignored by trade-action text analysis.
AiPlayerbot.TradeActionExcludedPrefixes = "RPLL_H_,DBMv4,{звезда} Questie,{rt1} Questie"

####################################################################################################
# LEVELS
####################################################################################################

# Disable random starting levels.
AiPlayerbot.DisableRandomLevels = 0

# Starting level used when random levels are disabled.
AiPlayerbot.RandombotStartingLevel = 5

# Chance a newly randomized bot starts at the configured minimum or maximum level.
AiPlayerbot.RandomBotMinLevelChance = 0.1
AiPlayerbot.RandomBotMaxLevelChance = 0.01

# Prevent random bots from leveling.
AiPlayerbot.RandomBotFixedLevel = 0

# Reset bots at max level back to the configured minimum level.
AiPlayerbot.DowngradeMaxLevelBot = 0

# Random bot XP multiplier. Effective rate is server XP rate times this value.
AiPlayerbot.RandomBotXPRate = 1.0

####################################################################################################
# GEAR
####################################################################################################

# Generic randombot gear caps.
AiPlayerbot.RandomGearQualityLimit = 3
AiPlayerbot.RandomGearScoreLimit = 0

# Allow bots to improve their generated gear over time.
AiPlayerbot.IncrementalGearInit = 1

# Minimum level for automatic enchants and gem-like maintenance behavior.
AiPlayerbot.MinEnchantingBotLevel = 60

# Legacy expansion gating toggles retained by the runtime.
AiPlayerbot.LimitEnchantExpansion = 1
AiPlayerbot.LimitGearExpansion = 1

# Chance a generated bot receives intentionally weaker gear.
AiPlayerbot.RandomGearLoweringChance = 0

# Require a minimum player gear level before some randombots accept invitations.
AiPlayerbot.GearScoreCheck = 0

# Preserve randomized equipment after a configured level threshold.
AiPlayerbot.EquipmentPersistence = 0
AiPlayerbot.EquipmentPersistenceLevel = 60

# Upgrade randombot equipment automatically on level-up.
AiPlayerbot.AutoUpgradeEquip = 1

# Hunter and pet defaults.
AiPlayerbot.HunterWolfPet = 0
AiPlayerbot.DefaultPetStance = 1
AiPlayerbot.PetChatCommandDebug = 0
AiPlayerbot.ExcludedHunterPetFamilies = ""

####################################################################################################
# ACTIVITIES
####################################################################################################

# Percentage of active bots in areas without nearby real players.
AiPlayerbot.BotActiveAlone = 10

# Force activity behavior when players are nearby.
AiPlayerbot.BotActiveAloneForceWhenInRadius = 150
AiPlayerbot.BotActiveAloneForceWhenInZone = 1
AiPlayerbot.BotActiveAloneForceWhenInMap = 0
AiPlayerbot.BotActiveAloneForceWhenIsFriend = 1
AiPlayerbot.BotActiveAloneForceWhenInGuild = 1

# Automatically scale active bot percentage based on server latency.
AiPlayerbot.botActiveAloneSmartScale = 1
AiPlayerbot.botActiveAloneSmartScaleDiffLimitfloor = 50
AiPlayerbot.botActiveAloneSmartScaleDiffLimitCeiling = 200
AiPlayerbot.botActiveAloneSmartScaleWhenMinLevel = 1
AiPlayerbot.botActiveAloneSmartScaleWhenMaxLevel = 80

####################################################################################################
# QUESTS
####################################################################################################

# Quest IDs completed and rewarded for all randombots.
AiPlayerbot.RandomBotQuestIds = "3802,5505,6502,7761,7848"

# Allow randombots to group with nearby bots for shared quests.
AiPlayerbot.RandomBotGroupNearby = 0

# Allow randombots to choose and complete quests on their own.
AiPlayerbot.AutoDoQuests = 1

# Quest items bots should never destroy.
AiPlayerbot.RandomBotQuestItems = "5175,5176,5177,5178,6948,11000,12382,13704,16309"

####################################################################################################
# SPELLS
####################################################################################################

# Learn quest reward spells automatically on level-up.
AiPlayerbot.AutoLearnQuestSpells = 0

# Learn trainer spells automatically on level-up.
AiPlayerbot.AutoLearnTrainerSpells = 1

# Spend talent points automatically on level-up.
AiPlayerbot.AutoPickTalents = 1

# Extra spells taught to every randombot and granted by maintenance to altbots.
# Use Vanilla-appropriate spell IDs here.
AiPlayerbot.RandomBotSpellIds = ""

# Spell used to open certain lootable gameobjects.
AiPlayerbot.OpenGoSpell = 6477

####################################################################################################
# STRATEGIES
####################################################################################################

# Additional randombot strategies applied after default role/spec strategies.
AiPlayerbot.RandomBotCombatStrategies = ""
AiPlayerbot.RandomBotNonCombatStrategies = ""

# Additional altbot strategy overrides.
AiPlayerbot.CombatStrategies = ""
AiPlayerbot.NonCombatStrategies = ""

# Remove the `healer dps` strategy on restricted maps.
AiPlayerbot.HealerDPSMapRestriction = 1

# Map IDs where `healer dps` is disabled when the restriction is enabled.
AiPlayerbot.RestrictedHealerDPSMaps = "33,34,36,43,47,48,70,90,109,129,209,229,230,329,349,389,429,1001,1004,1007,269,409,469,509,531,532,534,544,548,550,564,565,580,249,533,603,615,616,624,631,649"

####################################################################################################
# RPG STRATEGY
####################################################################################################

# Enable the newer RPG-style world behavior system.
AiPlayerbot.EnableNewRpgStrategy = 1

# Relative weights for RPG state selection.
AiPlayerbot.RpgStatusProbWeight.WanderRandom = 15
AiPlayerbot.RpgStatusProbWeight.WanderNpc = 20
AiPlayerbot.RpgStatusProbWeight.GoGrind = 15
